[MASTER]
# Use multiple processes to speed up Pylint
jobs=1

# Pickle collected data for later comparisons
persistent=yes

# List of plugins (as comma separated values of python module names) to load
load-plugins=

[MESSAGES CONTROL]
# Disable specific warnings that are too strict or not applicable
disable=
    C0103,  # Invalid name (snake_case)
    C0114,  # Missing module docstring
    C0115,  # Missing class docstring
    C0116,  # Missing function docstring
    R0913,  # Too many arguments
    R0914,  # Too many local variables
    R0915,  # Too many statements
    W0511,  # TODOs
    E0401,  # Import errors (due to relative imports in project structure)
    E0611,  # No name in module (due to relative imports)
    E1101,  # No member (false positives with dynamic modules like streamlit)

[FORMAT]
# Maximum number of characters on a single line
max-line-length=127

# Maximum number of lines in a module
max-module-lines=1000

[DESIGN]
# Maximum number of arguments for function / method
max-args=7

# Maximum number of attributes for a class
max-attributes=10

# Minimum number of public methods for a class
min-public-methods=1

# Maximum number of public methods for a class
max-public-methods=25

# Maximum number of return / yield for function / method body
max-returns=6

# Maximum number of branch for function / method body
max-branches=15

# Maximum number of statements in function / method body
max-statements=50


[SIMILARITIES]
# Minimum lines number of a similarity
min-similarity-lines=8

# Ignore comments when computing similarities
ignore-comments=yes

# Ignore docstrings when computing similarities
ignore-docstrings=yes

# Ignore imports when computing similarities
ignore-imports=yes

[BASIC]
# Good variable names which should always be accepted
good-names=i,j,k,ex,Run,_,id,db,logger,app,st

[IMPORTS]
# Allow wildcard imports from these modules
allow-wildcard-with-all=no

[LOGGING]
# The type of string formatting that logging methods do
logging-format-style=old

[TYPECHECK]
# List of module names for which member attributes should not be checked
ignored-modules=streamlit,cv2

# List of class names for which member attributes should not be checked
ignored-classes=streamlit

[EXCEPTIONS]
# Exceptions that will emit a warning when being caught
overgeneral-exceptions=builtins.BaseException,builtins.Exception
