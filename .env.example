# MediAI Environment Configuration Example
# Copy this file to .env and update with your actual values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mimic_iv

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# Model Configuration
MODEL_PATH=./models
SEPSIS_MODEL_VERSION=v1
MORTALITY_MODEL_VERSION=v1

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# Logging
LOG_LEVEL=INFO

# Encryption (IMPORTANT: Change in production!)
ENCRYPTION_KEY=mediai-default-key-change-in-production
ENCRYPTION_SALT=mediai-salt

# Feature Engineering
SEPSIS_FEATURES_COUNT=42
MORTALITY_FEATURES_COUNT=65

# LLM API Keys (choose one or more)
# DeepSeek API (recommended for medical applications)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API (alternative)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API (alternative)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Provider (deepseek, openai, or anthropic)
LLM_PROVIDER=deepseek

# RAG System Configuration
RAG_EMBEDDING_PROVIDER=sentence-transformers
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.5

# Medical Knowledge Base
KNOWLEDGE_BASE_DIR=./data/medical_knowledge
