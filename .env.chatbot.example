# ===================================================================
# MediAI Advanced Chatbot - API Keys & Configuration
# ===================================================================
# HƯỚNG DẪN: 
# 1. Copy file này thành .env.chatbot
# 2. Điền các API keys của bạn vào
# 3. KHÔNG BAO GIỜ commit file .env.chatbot lên git
# ===================================================================

# -------------------------------------------------------------------
# LAYER 6: LLM PROVIDERS
# -------------------------------------------------------------------

# Groq API (PRIMARY - FREE TIER)
# Đăng ký tại: https://console.groq.com/
# Free tier: 30 requests/minute, 14,400/day
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace (FALLBACK - Optional)
# Đăng ký tại: https://huggingface.co/settings/tokens
# Dùng cho download models, không bắt buộc nếu chạy local
HUGGINGFACE_TOKEN=your_huggingface_token_here

# -------------------------------------------------------------------
# LAYER 4: VECTOR STORE
# -------------------------------------------------------------------

# Qdrant Cloud (FREE 1GB)
# Đăng ký tại: https://cloud.qdrant.io/
# Tạo cluster → Copy URL và API Key
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# -------------------------------------------------------------------
# LAYER 3: MEDICAL KNOWLEDGE SOURCES
# -------------------------------------------------------------------

# NCBI E-utilities API (PubMed)
# Đăng ký tại: https://www.ncbi.nlm.nih.gov/account/
# Không bắt buộc nhưng tăng rate limit từ 3 req/s lên 10 req/s
NCBI_API_KEY=your_ncbi_api_key_here
NCBI_EMAIL=your_email@example.com

# Google Scholar (via scholarly library)
# Không cần API key, sử dụng scholarly library
# Lưu ý: Có thể bị rate limit nếu request quá nhiều

# -------------------------------------------------------------------
# OPTIONAL: Alternative LLM Providers
# -------------------------------------------------------------------

# DeepSeek API (Optional)
# Đăng ký tại: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API (Optional)
# Đăng ký tại: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API (Optional)
# Đăng ký tại: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API (Optional)
# Đăng ký tại: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here
