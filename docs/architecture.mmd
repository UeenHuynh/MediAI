graph TB
    subgraph "🎨 PRESENTATION LAYER"
        UI[Streamlit Web App<br/>Port 8501<br/>Multi-page Navigation]
        Auth[Authentication UI<br/>bcrypt + JWT]
        Dashboard[Dashboard<br/>Charts & Metrics]
        SepsisUI[Sepsis Prediction UI<br/>42 Features Form]
        MortalityUI[Mortality Prediction UI<br/>13 Features Form]
        ChatbotUI[Medical Chatbot UI<br/>RAG + Auto-enhance]
        Settings[Settings & Profile]
        Legal[Legal & HIPAA Docs]
    end

    subgraph "⚙️ APPLICATION LAYER - FastAPI"
        APIGateway[FastAPI Gateway<br/>Port 8000<br/>OpenAPI 3.0]
        
        subgraph "Routers"
            HealthRouter[/health<br/>Health Check]
            PredictRouter[/predict/sepsis<br/>/predict/mortality]
            PatientRouter[/patients/*<br/>Patient Data]
        end
        
        subgraph "Middleware"
            CORS[CORS Policy<br/>Whitelist Origins]
            ErrorHandler[Error Handler<br/>400/500 Responses]
            RateLimit[Rate Limiter<br/>100 req/min]
            Validator[Pydantic Validator<br/>Schema Enforcement]
        end
        
        subgraph "Services"
            PredictionSvc[Prediction Service<br/>Model Inference]
            CacheSvc[Cache Service<br/>Redis Integration]
            DBSvc[Database Service<br/>PostgreSQL]
            AuditSvc[Audit Service<br/>HIPAA Logging]
        end
    end

    subgraph "🤖 MEDICAL AI CHATBOT - Hybrid RAG"
        SafetyGuard[Safety Guardrails<br/>Emergency Detection]
        PromptEnhance[Auto Prompt Enhancement<br/>15+ Medical Patterns]
        
        subgraph "Tier 1: CAG Cache"
            CAGStore[Static Knowledge<br/>Guidelines & Protocols<br/>Priority: 4]
        end
        
        subgraph "Tier 2: Qdrant Vector DB"
            QdrantEmbed[BioBERT Embeddings<br/>768-dim vectors]
            QdrantSearch[Semantic Search<br/>Similarity > 0.5<br/>Priority: 3]
        end
        
        subgraph "Tier 3: PubMed API"
            NCBIApi[NCBI E-utilities<br/>10 req/sec with API key]
            PubMedFilter[Medical Filtering<br/>Priority: 2]
        end
        
        subgraph "Tier 4: Google Scholar"
            ScholarAPI[Scholarly Library<br/>scholarly v1.7.11]
            ScholarFilter[18 Medical Keywords<br/>Relevance Check<br/>Priority: 1]
        end
        
        RAGAggregator[Context Aggregation<br/>Dedup + Ranking<br/>Top-K=3, Max 1000 chars/doc]
        
        LLMEngine[Groq LLM<br/>llama-3.3-70b-versatile<br/>Temp: 0.3, Max tokens: 12K]
        
        CitationBuilder[Citation Builder<br/>PMID Links + Metadata]
    end

    subgraph "🧠 ML MODELS - Prediction"
        subgraph "Sepsis Model"
            SepsisModel[LightGBM v4.2<br/>AUROC: 0.89<br/>42 Features]
            SepsisSHAP[SHAP TreeExplainer<br/>Feature Importance]
        end
        
        subgraph "Mortality Model"
            MortalityModel[LightGBM v4.2<br/>AUROC: 0.65<br/>13 Features]
            MortSHAP[SHAP Explainer<br/>Risk Factors]
        end
        
        FeatureEng[Feature Engineering<br/>Scaling + Validation<br/>Missing Value Handling]
        ModelCache[Model Cache<br/>Pickle Files<br/>Feature Names]
    end

    subgraph "💾 DATA PROCESSING LAYER"
        subgraph "Embeddings"
            BioBERT[BioBERT Model<br/>Medical Text Encoder<br/>768-dim vectors]
            SentenceTransformer[sentence-transformers<br/>all-MiniLM-L6-v2]
        end
        
        subgraph "Document Processing"
            DocLoader[Document Loader<br/>PDF, MD, TXT]
            TextSplitter[Chunking Strategy<br/>500 tokens overlap]
            VectorStore[Vector Database<br/>Qdrant Cloud<br/>1GB Free Tier]
        end
    end

    subgraph "🗄️ DATA STORAGE"
        subgraph "PostgreSQL 16"
            RawSchema[(Raw Data<br/>MIMIC-IV Tables)]
            CleanSchema[(Cleaned Data<br/>Validated & Indexed)]
            FeatSchema[(Feature Store<br/>ML-Ready Tables)]
        end
        
        subgraph "Redis 7.2"
            RedisCache[LRU Cache<br/>256MB Limit<br/>1hr TTL]
            SessionStore[Session Store<br/>User State]
        end
        
        subgraph "File Storage"
            ModelFiles[models/*.pkl<br/>Trained Models]
            AuditLogs[logs/audit/*.log<br/>7-Year Retention]
            ChatHistory[.streamlit/chat_history.json<br/>Conversation State]
        end
    end

    subgraph "🌐 EXTERNAL APIS"
        NCBI[NCBI E-utilities<br/>PubMed + MedLine<br/>Medical Literature]
        ScholarExt[Google Scholar<br/>Academic Papers<br/>Via Scholarly Lib]
        QdrantCloud[Qdrant Cloud<br/>Vector Database<br/>cc4894e9-...]
        Supabase[Supabase<br/>PostgreSQL as Service<br/>mwavbkqfyybmxnnelazx]
    end

    subgraph "🔒 SECURITY & COMPLIANCE"
        Encryption[AES-256-GCM<br/>PBKDF2 Key Derivation<br/>cryptography v42]
        HIPAA[HIPAA Compliance<br/>Audit Trail<br/>7-Year Logs]
        GDPR[GDPR Controls<br/>Right to Erasure<br/>Data Portability]
        Secrets[Secret Management<br/>.env files<br/>gitignore protection]
    end

    subgraph "🔧 DEVOPS & TESTING"
        subgraph "CI/CD Pipeline"
            GHActions[GitHub Actions<br/>ci.yml + cd.yml]
            TestRunner[pytest 7.4<br/>34 tests, 27% coverage]
            Linter[flake8 + black<br/>PEP 8 Compliance]
            Security[bandit + safety<br/>Vulnerability Scan]
        end
        
        subgraph "Monitoring (Planned)"
            Prometheus[Prometheus<br/>Metrics Collection]
            Grafana[Grafana<br/>Dashboards]
        end
        
        Docker[Docker Compose<br/>Multi-container<br/>Orchestration]
    end

