graph TB
    subgraph "Input Layer - Query Processing"
        UserQuery[User Query<br/>'shock']
        SafetyCheck{Safety<br/>Guardrails}
        Emergency{Emergency<br/>Detection?}
        AutoEnhance{Auto-Enhance<br/>Enabled?}
    end

    subgraph "Prompt Enhancement System"
        PatternMatch[Pattern Matching<br/>15+ Medical Patterns]
        Enhanced[Enhanced Prompt<br/>Detailed Medical Context]
        Original[Original Query<br/>For Search]
    end

    subgraph "Tier 1: CAG - Static Cache"
        CAG_Check[Check CAG Cache]
        CAG_Results[Static Medical Knowledge<br/>Guidelines, Protocols]
    end

    subgraph "Tier 2: Qdrant - Semantic Search"
        Qdrant_Embed[Generate Embeddings<br/>BioBERT]
        Qdrant_Search[Vector Similarity Search]
        Qdrant_Results[Relevant Documents<br/>Score > 0.5]
    end

    subgraph "Tier 3: PubMed - Latest Research"
        PubMed_Query[NCBI E-utilities API]
        PubMed_Filter[Medical Keywords Filter]
        PubMed_Results[Recent Papers<br/>with PMID]
    end

    subgraph "Tier 4: Google Scholar - Academic Papers"
        Scholar_Query[Scholarly Library]
        Scholar_Enhance[Add Medical Keywords<br/>'medical treatment clinical']
        Scholar_Filter[Relevance Filter<br/>Medical Terms Check]
        Scholar_Results[Academic Papers<br/>Filtered by Domain]
    end

    subgraph "Context Aggregation"
        Dedup[Deduplicate Results]
        Rank[Tier-based Ranking<br/>CAG=4, Qdrant=3<br/>PubMed=2, Scholar=1]
        TopK[Select Top 3<br/>Token Limit Control]
        Truncate[Truncate to 1000 chars<br/>per document]
    end

    subgraph "LLM Generation"
        BuildPrompt[Build Context Prompt<br/>System + User + Context]
        LLM[Groq/DeepSeek LLM<br/>llama-3.3-70b]
        TokenCheck{Token Count<br/>< 12K?}
    end

    subgraph "Output Processing"
        Generate[Generate Answer<br/>with [1], [2], [3] refs]
        Citations[Build Citations Metadata<br/>PMID, URLs, Titles]
        Disclaimer[Add Medical Disclaimer]
        Display[Display Response<br/>+ 📚 Sources Expander]
    end

    %% Flow
    UserQuery --> SafetyCheck
    SafetyCheck -->|Unsafe| Emergency
    SafetyCheck -->|Safe| AutoEnhance
    Emergency -->|Yes| Display
    
    AutoEnhance -->|Yes| PatternMatch
    AutoEnhance -->|No| Original
    PatternMatch --> Enhanced
    PatternMatch --> Original
    
    Enhanced --> CAG_Check
    Original --> CAG_Check
    Original --> Qdrant_Embed
    Original --> PubMed_Query
    Original --> Scholar_Query
    
    CAG_Check --> CAG_Results
    
    Qdrant_Embed --> Qdrant_Search
    Qdrant_Search --> Qdrant_Results
    
    PubMed_Query --> PubMed_Filter
    PubMed_Filter --> PubMed_Results
    
    Scholar_Query --> Scholar_Enhance
    Scholar_Enhance --> Scholar_Filter
    Scholar_Filter --> Scholar_Results
    
    CAG_Results --> Dedup
    Qdrant_Results --> Dedup
    PubMed_Results --> Dedup
    Scholar_Results --> Dedup
    
    Dedup --> Rank
    Rank --> TopK
    TopK --> Truncate
    
    Truncate --> BuildPrompt
    Enhanced --> BuildPrompt
    BuildPrompt --> TokenCheck
    TokenCheck -->|No| TopK
    TokenCheck -->|Yes| LLM
    
    LLM --> Generate
    Generate --> Citations
    Citations --> Disclaimer
    Disclaimer --> Display

    %% Styling
    classDef inputClass fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef enhanceClass fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef tier1Class fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef tier2Class fill:#fff3e0,stroke:#ef6c00,stroke-width:2px
    classDef tier3Class fill:#fce4ec,stroke:#c2185b,stroke-width:2px
    classDef tier4Class fill:#e0f2f1,stroke:#00695c,stroke-width:2px
    classDef contextClass fill:#fff9c4,stroke:#f57f17,stroke-width:2px
    classDef llmClass fill:#ffebee,stroke:#c62828,stroke-width:2px
    classDef outputClass fill:#e8eaf6,stroke:#283593,stroke-width:2px

    class UserQuery,SafetyCheck,Emergency,AutoEnhance inputClass
    class PatternMatch,Enhanced,Original enhanceClass
    class CAG_Check,CAG_Results tier1Class
    class Qdrant_Embed,Qdrant_Search,Qdrant_Results tier2Class
    class PubMed_Query,PubMed_Filter,PubMed_Results tier3Class
    class Scholar_Query,Scholar_Enhance,Scholar_Filter,Scholar_Results tier4Class
    class Dedup,Rank,TopK,Truncate contextClass
    class BuildPrompt,LLM,TokenCheck llmClass
    class Generate,Citations,Disclaimer,Display outputClass
