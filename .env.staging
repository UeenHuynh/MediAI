# MediAI Staging Environment Configuration
# Copy to .env for staging deployment

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=staging
DEBUG=true
LOG_LEVEL=DEBUG

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mediai_staging
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=1800
CACHE_MAX_SIZE=500

# =============================================================================
# MODEL CONFIGURATION (V2 Models)
# =============================================================================
MODEL_PATH=./api/models
SEPSIS_MODEL_FILE=sepsis_lightgbm_v2.pkl
SEPSIS_FEATURES_FILE=sepsis_feature_names_v2.pkl
MORTALITY_MODEL_FILE=mortality_lightgbm_v2.pkl
MORTALITY_FEATURES_FILE=mortality_feature_names_v2.pkl

# Model versions
SEPSIS_MODEL_VERSION=v2
MORTALITY_MODEL_VERSION=v2

# Feature counts
SEPSIS_FEATURES_COUNT=42
MORTALITY_FEATURES_COUNT=61

# =============================================================================
# CORS - Allow frontend access
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://frontend:3000

# =============================================================================
# DATA SOURCES (CSV until Phase 5 complete)
# =============================================================================
DATA_SOURCE=csv
CSV_DATA_PATH=./data/sample_kaggle

# =============================================================================
# SECURITY
# =============================================================================
# WARNING: Change these in production!
ENCRYPTION_KEY=staging-key-change-in-production
ENCRYPTION_SALT=staging-salt-change-in-production
SECRET_KEY=staging-secret-key-replace-me

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
ENABLE_METRICS=true
ENABLE_TRACING=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# LLM API KEYS (for chatbot features)
# =============================================================================
# DeepSeek API (recommended for medical applications)
DEEPSEEK_API_KEY=

# OpenAI API (alternative)
OPENAI_API_KEY=

# Anthropic Claude API (alternative)
ANTHROPIC_API_KEY=

# LLM Provider (deepseek, openai, or anthropic)
LLM_PROVIDER=deepseek

# =============================================================================
# RAG SYSTEM CONFIGURATION
# =============================================================================
RAG_EMBEDDING_PROVIDER=sentence-transformers
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.5

# Medical Knowledge Base
KNOWLEDGE_BASE_DIR=./data/medical_knowledge

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_PREDICTIONS=true
ENABLE_CHATBOT=true
ENABLE_ANALYTICS=false
ENABLE_DATABASE=false

# =============================================================================
# TESTING
# =============================================================================
TEST_MODE=false
MOCK_PREDICTIONS=false
