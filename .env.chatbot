# ===================================================================
# MediAI Advanced Chatbot - API Keys & Configuration
# ===================================================================
# HƯỚNG DẪN: Copy các giá trị này vào file .env chính
# Hoặc source file này: source .env.chatbot
# ===================================================================

# -------------------------------------------------------------------
# LAYER 6: LLM PROVIDERS
# -------------------------------------------------------------------

# Groq API (PRIMARY - FREE TIER)
# Đăng ký tại: https://console.groq.com/
# Free tier: 30 requests/minute, 14,400/day
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace (FALLBACK - Optional)
# Đăng ký tại: https://huggingface.co/settings/tokens
# Dùng cho download models, không bắt buộc nếu chạy local
HUGGINGFACE_TOKEN=your_huggingface_token_here_optional

# -------------------------------------------------------------------
# LAYER 4: VECTOR STORE
# -------------------------------------------------------------------

# Qdrant Cloud (FREE 1GB)
# Đăng ký tại: https://cloud.qdrant.io/
# Tạo cluster → Copy URL và API Key
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=medical_knowledge

# -------------------------------------------------------------------
# LAYER 5: DATABASE (Supabase)
# -------------------------------------------------------------------

# Supabase PostgreSQL (FREE 500MB)
# Đăng ký tại: https://supabase.com/
# Project Settings → Database → Connection String
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# -------------------------------------------------------------------
# LAYER 3: EXTERNAL APIS
# -------------------------------------------------------------------

# PubMed API (NCBI E-utilities)
# Đăng ký tại: https://www.ncbi.nlm.nih.gov/account/
# KHÔNG bắt buộc - có thể dùng mà không cần API key, nhưng có key thì rate limit cao hơn
NCBI_API_KEY=your_ncbi_api_key_here_optional
NCBI_EMAIL=your_email@example.com

# -------------------------------------------------------------------
# CHATBOT CONFIGURATION
# -------------------------------------------------------------------

# LLM Settings
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=huggingface
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
HF_LOCAL_MODEL=microsoft/phi-2

# RAG Settings
RAG_STRATEGY=hybrid  # Options: hybrid, cag_only, vector_only
RAG_TOP_K=5
RAG_CAG_ENABLED=true
RAG_QDRANT_ENABLED=true
RAG_PUBMED_ENABLED=true

# PII Masking
PII_MASKING_ENABLED=true
PII_SPACY_MODEL=en_core_web_sm

# Agent Settings
AGENT_MAX_ITERATIONS=5
AGENT_VALIDATION_RETRIES=2
AGENT_TIMEOUT_SECONDS=30

# Rate Limiting
GROQ_RATE_LIMIT=30  # requests per minute
PUBMED_RATE_LIMIT=3  # requests per second

# -------------------------------------------------------------------
# DEVELOPMENT SETTINGS
# -------------------------------------------------------------------
DEBUG_CHATBOT=false
LOG_LEVEL=INFO
ENABLE_AGENT_TRACING=false
