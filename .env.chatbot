# HƯỚNG DẪN: Copy các giá trị này vào file .env chính
# Hoặc source file này: source .env.chatbot
# ===================================================================

# -------------------------------------------------------------------
# LAYER 6: LLM PROVIDERS
# -------------------------------------------------------------------

# Groq API (PRIMARY - FREE TIER)
# Đăng ký tại: https://console.groq.com/
# Free tier: 30 requests/minute, 14,400/day
GROQ_API_KEY=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


# HuggingFace (FALLBACK - Optional)
# Đăng ký tại: https://huggingface.co/settings/tokens
# Dùng cho download models, không bắt buộc nếu chạy local
HUGGINGFACE_TOKEN=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

# -------------------------------------------------------------------
# LAYER 4: VECTOR STORE
# -------------------------------------------------------------------

# Qdrant Cloud (FREE 1GB)
# Đăng ký tại: https://cloud.qdrant.io/
# Tạo cluster → Copy URL và API Key
QDRANT_URL=https://cc4894e9-2eea-4528-a91a-bbf5e5711045
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIn0.Dtaqq98U27lqrs-45Qo5vNTqDcCEV76f5epqEJwhMPM
QDRANT_COLLECTION_NAME=MediAI

# -------------------------------------------------------------------
# LAYER 5: DATABASE (Supabase)
# -------------------------------------------------------------------

# Supabase PostgreSQL (FREE 500MB)
# Đăng ký tại: https://supabase.com/
